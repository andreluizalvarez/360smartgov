OPENAI_API_KEY=sk-proj-SUA_CHAVE_AQUI

# Configuracao de e-mail
# Provedor: brevo | resend | gmail | auto (auto usa o primeiro configurado,
# nesta ordem: brevo, resend, gmail).
#
# ATENCAO: servidores em nuvem (DigitalOcean, AWS, GCP...) costumam bloquear
# as portas de SMTP (25, 465, 587). Nesses casos o Gmail SMTP nunca conecta.
# Prefira um provedor por HTTPS: Brevo (gratuito, so exige verificar o e-mail
# remetente) ou Resend (exige um dominio proprio verificado).
EMAIL_PROVIDER=auto

# Brevo (https://app.brevo.com > SMTP & API > API Keys). O remetente precisa
# estar verificado em Senders & IP.
BREVO_API_KEY=xkeysib-SUA_CHAVE_AQUI
BREVO_FROM_EMAIL=no-reply@seudominio.com.br
BREVO_FROM_NAME=SmartGov 360

# Gmail SMTP (requer senha de app). Sem GMAIL_SMTP_PORT tenta 465 e depois 587.
GMAIL_USER=seu-email@gmail.com
GMAIL_APP_PASSWORD=sua_senha_de_app
GMAIL_FROM_EMAIL=seu-email@gmail.com
GMAIL_SMTP_PORT=

RESEND_API_KEY=re_SUA_CHAVE_AQUI
RESEND_FROM_EMAIL=

# Configuracao Twilio/WhatsApp
TWILIO_ACCOUNT_SID=SEU_ACCOUNT_SID
TWILIO_AUTH_TOKEN=SEU_AUTH_TOKEN
TWILIO_WHATSAPP_FROM=+14155238886
